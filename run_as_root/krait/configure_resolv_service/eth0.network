# This network file matches the container-side of the virtual Ethernet link
# created by systemd-nspawn's --network-veth switch. See systemd-nspawn(1) for
# details.

[Match]
Name=eth0

[Network]
DHCP=yes
LLMNR=yes

[DHCP]
UseDNS=true
UseTimezone=yes
UseDomains=true

#[DHCPv4]
#UseDNS=true
#UseDomains=true

#[DHCPv6]
#UseDNS=true
#UseDomains=true

[IPv6AcceptRA]
UseDNS=true
UseDomains=yes

#!/bin/sh -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing.

# Reason for using --noflush option with iptables-restore command:
# If we simply use iptables-restore < /etc/iptables.port-rules, by default it flushes (clears) all existing rules, chains, and counters before loading these new ones.
# When we use --noflush then it does not flush existing rules before loading the new ones, instead it merges the new rules on top of the current configuration.

/usr/sbin/iptables-restore --noflush < /etc/iptables.port-rules
exit 0

#!/bin/bash

uuencode=1
binary=0

Print_Help()
{
    cat << EOH >&2
 $0 bagheera install version v:0.0.3

 1) Getting help or info about $0 :
  $0 --help   Print this message
  .......................................................................

  $0 --deviceId <deviceId>  [additional arguments to embedded script]
  with following options (in that order)
  -deviceId | --deviceId <deviceId>    	Driver identification
  -sessionId | --sessionId <sessionId>  Session Id
  -ssid | --ssid <wifi ssid> 		Wifi HotSpot SSID 
  -ssidPassword | --ssidPassword        Wifi SSID password
  -lanecal | --lanecal	 [keep|delete]		laneCal.json to clean on reboot, default delete 
  -saveMP4 | --saveMP4	 [keep|delete]		saveMP4 folder to clean on reboot default delete
  -device  | --deviceType 		specify the device type (default is bagheera)
  -deviceSub | --deviceSubType		specify the device sub (type default is dvt2)
  -vehClass| --vehClass  <vehClass>     used by the analytics engine to determine the vehicle class to pick the correct lane cal parameters
  -profileName | --profileName                  LTE carrier profile name
  -apnName | --apnName                          LTE carrier apn name

EOH
}

#untar bootstrap
function untar_payload()
{
	echo -e "Setting up the bootstrap /home/ubuntu/.nddevice \n ------------------------------------------------------------"
	match=$(grep --text --line-number '^BOOTSTRAP_TAR_ZIP:$' $0 | cut -d ':' -f 1)
	payload_start=$((match + 1))
	if [[ $binary -ne 0 ]]; then
		tail -n +$payload_start $0 | tar -xzvf - -C /home/ubuntu/.nddevice 
	fi
	if [[ $uuencode -ne 0 ]]; then
		tail -n +$payload_start $0 | uudecode | tar -xzvf - -C /home/ubuntu/.nddevice
	fi
	
	#move wrapper to bin folder
	echo -e "Moving wrapper to /home/ubuntu/bin folder"
	mv /home/ubuntu/.nddevice/wrapper_* /home/ubuntu/bin/.
	#check if lanecal is provided
	if [ "$lanecal" == "keep" ]; then
		#if lanecal is keep than we will add a default one to /home/ubuntu/config/
	
		echo -e "Moving laneCal.json to /home/ubuntu/config/ as keep is enabled for it"
		mv /home/ubuntu/.nddevice/laneCal.json /home/ubuntu/config/.

	fi 
	add_nd_service_script
	add_system_upgrade_script
	add_lte_flash_script
	add_isp_flash_script
        add_apn_config_binary
	add_lte_disable_enable_script
        add_get_isp_ver_and_temp
        add_obd_script_and_wrapper_script
	sync
	echo -e "Setup of bootstrap /home/ubuntu/.nddevice is completed \n ----------------------------------------------------- "
}

#delete default setup from shield
function delete_default_setup()
{
	echo "Going to delete the default setup"
	#delete autocam .nddevice  bagheera_service service
        sudo rm -rf /home/ubuntu/.nddevice
        sudo rm -rf /home/ubuntu/autocam
        sudo rm -rf /home/ubuntu/config
        sudo rm -rf /home/ubuntu/work
        sudo rm -rf /home/ubuntu/bagheera_service
        sudo rm -rf /home/ubuntu/service
	
	#delete wrapper from the bin folder
	sudo rm /home/ubuntu/bin/wrapper_*
	echo "Default setup deleted ..."
}

#Create user and make folder
function add_user()
{
	echo "Adding user ..."
	#########Create user############
	sudo userdel -r iriscli
	sudo useradd -m iriscli
	sudo mkdir -m 777 /home/iriscli/ND_INPUT
	sudo mkdir -m 777 /home/iriscli/ND_OUTPUT
	chmod 777 
	################################
	echo "Adding user: done"

}
#Add new files, folder and configuration
function add_new_files_conf()
{
		
	echo "Going to Add new configuration"
	folder_home="/home/ubuntu/.nddevice"
	folder_conf="/home/ubuntu/config"
	folder_saveMP4="/home/iriscli/saveMP4"
	
	bashrc_file="/home/ubuntu/.bashrc"
	#create folder /home/ubuntu/.nddevice
	if [ ! -d "$folder_home" ]; then
		mkdir "$folder_home"
		echo -e "\t$folder_home is created"
	fi 
	#Add new folder 
        [ -d /home/ubuntu/autocam ] || mkdir /home/ubuntu/autocam
        [ -d /home/ubuntu/config ] || mkdir /home/ubuntu/config
        [ -d /home/ubuntu/bin ] || mkdir /home/ubuntu/bin
        [ -d /home/ubuntu/work ] || mkdir /home/ubuntu/work
        [ -d /home/ubuntu/bagheera_service ] || mkdir /home/ubuntu/bagheera_service
        [ -d /home/ubuntu/service ] || mkdir /home/ubuntu/service
	
	#Add Environment variable 
	
	#if there is any default environment the delete it and add below
	#export ND_INPUT_PATH=/home/iriscli/ND_INPUT
        #export ND_OUTPUT_PATH=/home/iriscli/ND_OUTPUT
        #export ND_DEVICE_REL_PATH=/home/ubuntu/.nddevice
        #export ND_CONFIG_PATH=$ND_DEVICE_REL_PATH/latest/nd_config.ini
	echo -e "\tEnvironment variables are added"

	sed -i 's/.*ND_INPUT_PATH.*$//' $bashrc_file	
	sed -i 's/.*ND_OUTPUT_PATH.*$//' $bashrc_file	
	sed -i 's/.*ND_DEVICE_REL_PATH.*$//' $bashrc_file		
	sed -i 's/.*ND_CONFIG_PATH.*$//' $bashrc_file		
	
	echo "export ND_INPUT_PATH=/home/iriscli/ND_INPUT" >> $bashrc_file
	echo "export ND_OUTPUT_PATH=/home/iriscli/ND_OUTPUT" >> $bashrc_file
	echo "export ND_DEVICE_REL_PATH=/home/ubuntu/.nddevice" >> $bashrc_file
	echo "export ND_CONFIG_PATH=\$ND_DEVICE_REL_PATH/latest/nd_config.ini" >> $bashrc_file

	#Alias
	
	#alias for navigation 
	echo "alias gi='cd /home/iriscli/ND_INPUT/'" >> $bashrc_file
	echo "alias go='cd /home/iriscli/ND_OUTPUT/'" >> $bashrc_file
	echo "alias gl='cd /home/ubuntu/.nddevice/log'" >> $bashrc_file
	echo "alias gh='cd /home/ubuntu/.nddevice'" >> $bashrc_file

	#alias for grep
	alias greps='grep _STATE /home/iriscli/ND_INPUT/*.STATE'

	#add new configuration

	#Create /home/ubuntu/config folder
	if [ ! -d "$folder_conf" ]; then
		mkdir "$folder_conf"
	fi 

	echo  "Going to create a deviceconfig.ini"
	#Go to /home/ubuntu/config and create nd_config.ini
	#Sample:-

        #       [identity]
        #       deviceId = NDPRAVEEN
        #      sessionId = NDPRAVEEN
	if [ -f "$folder_conf/deviceconfig.ini" ]; then
		rm "$folder_conf/deviceconfig.ini"
	fi

	if [ ! -f "$folder_conf/deviceconfig.ini" ]; then
		touch "$folder_conf/deviceconfig.ini"
	fi

	#identity	
	echo -e "\t[identity]\n:::\tdeviceId = $deviceId\tsessionId = $sessionId \tdeviceType =$deviceType\tdeviceSubType =$deviceSubType\n"
	echo "[identity]" > "$folder_conf/deviceconfig.ini"
	echo "deviceId = $deviceId" >> "$folder_conf/deviceconfig.ini"
	echo "sessionId = $sessionId" >> "$folder_conf/deviceconfig.ini"
	#deviceType
	echo "deviceType = $deviceType">> "$folder_conf/deviceconfig.ini"
	#deviceSubType
	echo "deviceSubType = $deviceSubType">> "$folder_conf/deviceconfig.ini"
	echo -e "\n\n" >> "$folder_conf/deviceconfig.ini"
        #vehicle
	echo -e "\t[vehicle]\nvehClass = $vehClass"
	echo "[vehicle]" >> "$folder_conf/deviceconfig.ini"
	echo "vehClass = $vehClass" >> "$folder_conf/deviceconfig.ini"
	echo -e "\n\n" >> "$folder_conf/deviceconfig.ini"

	
	#cleanup	
	echo -e "\t[cleanup]\nlanecal = $lanecal\nsaveMP4 = $saveMP4"
	echo "[cleanup]" >> "$folder_conf/deviceconfig.ini"
	echo "lanecal = $lanecal" >> "$folder_conf/deviceconfig.ini"
	echo "saveMP4 = $saveMP4" >> "$folder_conf/deviceconfig.ini"

	#Going to create folder 
	echo -e "\tGoing to create $folder_saveMP4 need sudo permission..."
	sudo mkdir "$folder_saveMP4"
	sudo chmod 777 "$folder_saveMP4"	
	echo "New configuration added successfully"


}

function add_obd_script_and_wrapper_script(){
       
        echo "Adding obd_fm_upgrade.sh script..."
        sudoer_file="/etc/sudoers.d/ubuntu_admin"
        if [ -f $sudoer_file ]; then
                echo "File Exist"
                sudo sh -c  "sed -i 's/.*wrapper_script.sh.*$//' $sudoer_file ; echo  'ubuntu ALL=NOPASSWD:/usr/bin/wrapper_script.sh' >> $sudoer_file"
                sudo sh -c  "sed -i 's/.*home*wrapper_script.sh.*$//' $sudoer_file ; echo  'ubuntu ALL=NOPASSWD:/home/ubuntu/bin/wrapper_script.sh' >> $sudoer_file"
                sudo sh -c  "sed -i 's/.*obd_fm_upgrade.*$//' $sudoer_file ; echo  'ubuntu ALL=NOPASSWD:/usr/bin/obd_fm_upgrade.sh' >> $sudoer_file"
                sudo sh -c  "sed -i 's/.*home*obd_fm_upgrade.*$//' $sudoer_file ; echo  'ubuntu ALL=NOPASSWD:/home/ubuntu/bin/obd_fm_upgrade.sh' >> $sudoer_file"


        else
                echo "File Not Exist"
                #sudo chmod 700 $sudoer_file
                sudo sh -c "echo  'ubuntu ALL=NOPASSWD:/usr/bin/wrapper_script.sh' >> $sudoer_file"
                sudo sh -c "echo  'ubuntu ALL=NOPASSWD:/home/ubuntu/bin/wrapper_script.sh' >> $sudoer_file"
                sudo sh -c "echo  'ubuntu ALL=NOPASSWD:/usr/bin/obd_fm_upgrade.sh' >> $sudoer_file"
                sudo sh -c "echo  'ubuntu ALL=NOPASSWD:/home/ubuntu/bin/obd_fm_upgrade.sh' >> $sudoer_file"
        fi
        sudo chmod 440 $sudoer_file


}

       


function add_get_isp_ver_and_temp(){

        echo "Adding get_isp_ver_and_temp too sudoer list"

        sudoer_file="/etc/sudoers.d/ubuntu_admin"
        out_temp_bin_file="/bin/get_isp_ver_and_temp"
        lte_gps_sample_app_bin_file="/bin/lte_gps_sample_app"

        if [ ! -f $out_temp_bin_file ]; then
                echo "$out_temp_bin_file  file not exist"
                exit 0
        fi

        if [ ! -f $lte_gps_sample_app_bin_file ]; then
                echo "$lte_gps_sample_app_bin_file  file not exist"
                exit 0
        fi

        if [ -f $sudoer_file ]; then
                echo "File Exist"
                sudo sh -c  "sed -i 's/.*get_isp_ver_and_temp.*$//' $sudoer_file ; echo  'ubuntu ALL=NOPASSWD:/bin/get_isp_ver_and_temp' >> $sudoer_file"
                sudo sh -c  "sed -i 's/.*lte_gps_sample_app.*$//' $sudoer_file ; echo  'ubuntu ALL=NOPASSWD:/bin/lte_gps_sample_app' >> $sudoer_file"

        else
                echo "File Not Exist"
                #sudo chmod 700 $sudoer_file
                sudo sh -c "echo  'ubuntu ALL=NOPASSWD:/bin/get_isp_ver_and_temp' >> $sudoer_file"
                sudo sh -c "echo  'ubuntu ALL=NOPASSWD:/bin/lte_gps_sample_app' >> $sudoer_file"
        fi
        sudo chmod 440 $sudoer_file

        echo "Adding get_isp_ver_and_temp too sudoer list done"
}

#add nd_service.sh for managing the services
function add_nd_service_script()
{
	echo "Adding nd_service.sh script..."
	sudo cp /home/ubuntu/.nddevice/nd_service.sh /usr/bin/.

	sudoer_file="/etc/sudoers.d/ubuntu_admin"
	if [ -f $sudoer_file ]; then
		echo "File Exist"
		sudo sh -c  "sed -i 's/.*nd_service.*$//' $sudoer_file ; echo  'ubuntu ALL=NOPASSWD:/usr/bin/nd_service.sh' >> $sudoer_file"
	else
		echo "File Not Exist"
		#sudo chmod 700 $sudoer_file
		sudo sh -c "echo  'ubuntu ALL=NOPASSWD:/usr/bin/nd_service.sh' >> $sudoer_file"
	fi
	sudo chmod 440 $sudoer_file

	echo "Adding nd_service.sh script done"
}


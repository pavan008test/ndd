[Unit]
Description=NDService-nd_dta


After=network.target ntdi_bag3.service
Wants=ntdi_bag3.service


[Service]
TimeoutStartSec=1
TimeoutStopSec=5
KillMode=mixed
SendSIGKILL=yes

ExecStart=/home/ubuntu/bin/wrapper_service.sh nd_dta


Restart=on-failure

RestartSec=10s

[Install]
WantedBy=multi-user.target

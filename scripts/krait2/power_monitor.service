[Unit]
Description=NDService-power_monitor

After=clik.service qmmf-server.service systemrw.mount leprop.service audioPlayback.service
Wants=qmmf-server.service systemrw.mount audioPlayback.service


[Service]
TimeoutStartSec=1
TimeoutStopSec=5
KillMode=mixed
SendSIGKILL=yes

ExecStart=/home/ubuntu/bin/wrapper_service.sh power_monitor

Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target



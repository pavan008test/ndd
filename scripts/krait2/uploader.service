[Unit]
Description=NDService-Uploader

After=clik.service qmmf-server.service systemrw.mount leprop.service
Wants=qmmf-server.service systemrw.mount

[Service]
TimeoutStartSec=1
TimeoutStopSec=5
KillMode=mixed
SendSIGKILL=yes

ExecStart=/home/ubuntu/bin/wrapper_service.sh uploader

Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target


